{
  "name": "onegrainofrice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "BUILD_ID=${BUILD_ID:-$(date +%s%3N)} next build",
    "start": "next start -p 3006",
    "lint": "eslint",
    "grains:ws": "node --env-file-if-exists=.env.local --import tsx server/grains-ws/index.ts",
    "grains:ws:dev": "node --env-file-if-exists=.env.local --watch --import tsx server/grains-ws/index.ts",
    "grains:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/grains-smoke.ts",
    "grains:loadtest": "node --import tsx scripts/grains-loadtest.ts",
    "placeholders": "node scripts/gen-placeholders.mjs",
    "gen:memes": "node scripts/gen-placeholders.mjs",
    "gen:pfp": "node scripts/gen-pfp.mjs",
    "gen:brand": "node scripts/gen-brand.mjs",
    "gen:sfx": "node scripts/gen-sfx.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.4",
    "better-sqlite3": "^12.11.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "openai": "^6.45.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.23.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
