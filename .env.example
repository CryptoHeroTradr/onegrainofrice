# Copy to .env.local and fill in real values.

# Swap link — Jupiter / pump.fun / Raydium URL for buying $RICE.
# Defaults in code to https://jup.ag/swap/SOL-<mint>; override here if needed.
NEXT_PUBLIC_BUY_URL=https://jup.ag/swap?sell=So11111111111111111111111111111111111111112&buy=2wQq3MrFFHPQnapMt1wnZ2vGkVZDv5ENDCrdLCqFpump

# RiceDAO village/game URL (nav "Village" + hero secondary CTA).
NEXT_PUBLIC_VILLAGE_URL=http://209.141.52.60/RiceDAO/

# SERVER-SIDE ONLY (optional). Public DAO proposals feed for the vote bowls.
# RiceDAO's proposals API is wallet-gated (no public read), so leave this unset
# and /api/dao serves the clearly-labeled illustrative example. Set it to a
# public JSON feed ({question, options:[{label,votes}]}) to go live.
# RICEDAO_DAO_FEED=

# The real $RICE mint address (shown with a copy button on the site).
NEXT_PUBLIC_TOKEN_ADDRESS=2wQq3MrFFHPQnapMt1wnZ2vGkVZDv5ENDCrdLCqFpump

# SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# Base URL of the RiceDAO Express API, reached only by the Next server proxy at
# /onegrainofrice/api/*. On the VPS this is the internal loopback address.
RICEDAO_API_BASE=http://127.0.0.1:1112

# SERVER-SIDE ONLY (no NEXT_PUBLIC_ prefix — never exposed to the browser).
# OpenAI API key for the PFP AI features (AI Enhance, Rice Art Generator,
# Generate PFP). Read only inside the /api/pfp/* Next route handlers, so it
# never reaches the client bundle. Leave unset to run with AI disabled — the
# Layer Composer still works fully client-side (compose + download); the AI
# buttons then show the "requires an OpenAI API key" fallback message.
# OPENAI_API_KEY=sk-...
# Optional model overrides (default gpt-image-1 for all three):
# PFP_EDIT_MODEL=gpt-image-1
# PFP_GEN_MODEL=gpt-image-1
# PFP_PFP_MODEL=gpt-image-1

# Belt-and-braces: Next.js telemetry is already disabled via `next telemetry disable`,
# this env var enforces it in CI/other machines too.
NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# GRAINS clicker game (/onegrainofrice/grains) — SERVER-SIDE ONLY.
# None of these are NEXT_PUBLIC_, so they never reach the browser bundle. Read
# only by the grains DB module (src/lib/grains/*), route handlers, and the WS
# server. Add these to the Next app AND the WS server env (e.g. pm2 env).
# ---------------------------------------------------------------------------

# Absolute, persistent path to the SQLite file (inside the rsync backup scope).
# The directory is created on boot if missing. Defaults to <cwd>/data/grains.db.
GRAINS_DB_PATH=/home/deploy/onegrainofrice/data/grains.db

# Port the realtime grains WebSocket server listens on (Phase 2+). Default 3007.
GRAINS_WS_PORT=3007

# REQUIRED. Random 32+ char secret used to salt the one-way sha256 IP hash
# stored at rest (raw IPs are never persisted). Generate: openssl rand -hex 32
GRAINS_IP_SALT=

# REQUIRED. Random 32+ char secret that signs the `grain_vid` visitor cookie.
# Generate: openssl rand -hex 32
GRAINS_COOKIE_SECRET=

# Per-visitor server-side clamp: max grains counted per second. Default 20.
# Tighten this (e.g. 8) if bot pressure appears — it caps how fast any single
# visitor's grains are credited regardless of how fast the client sends.
GRAINS_MAX_PER_SEC=20

# Abuse cap: max simultaneous WS connections sharing one IP hash. Default 8.
# Excess connections are closed with code 4429. Lower it to tighten under attack.
GRAINS_MAX_CONN_PER_IP=8

# Optional dev override for the grains WebSocket URL (browser-exposed). In prod
# leave unset: the client derives wss://<host>/onegrainofrice/grains/ws and nginx
# proxies it to the WS server. For local dev (no nginx) point it straight at the
# WS port; include the /onegrainofrice path so the basePath-scoped cookie is sent:
# NEXT_PUBLIC_GRAINS_WS_URL=ws://localhost:3007/onegrainofrice/grains/ws
