# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# grains game — SQLite database + WAL/SHM sidecars (runtime data, never committed)
/data/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but .env.example is documentation and SHOULD be committed.
!.env.example

# Filled MaxMind config (real license key) — never commit; template is .example.
deploy/geoip/GeoIP.conf.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code — per-machine local settings (not shared), matching the bot repo.
.claude/settings.local.json
