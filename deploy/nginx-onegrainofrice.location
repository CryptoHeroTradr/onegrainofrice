    # --- $RICE landing page (Next.js, basePath=/onegrainofrice) ---
    # Longest-prefix match wins, so /onegrainofrice/_next/ and
    # /onegrainofrice/memes/ stay with this app and never fall through to the
    # root /_next/ (CXMZ) or /memes/ (RiceDAO) locations. No trailing slash on
    # proxy_pass: keep the /onegrainofrice prefix intact to match basePath.
    location ^~ /onegrainofrice {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
